{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO article outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["direction", "chapters", "references", "coverage_check"],
  "properties": {
    "direction": {
      "type": "string",
      "description": "記事の方向性から構成案そのものを除いた内容。読者・目的・範囲・文体・必要条件、全体文字数の目標、基礎説明は補足可能だが具体情報は参照に限定する方針を後工程へ引き継ぐ。"
    },
    "chapters": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "evidence_type", "targetCharCount", "overview", "cautions", "sections"],
        "properties": {
          "id": { "type": "string", "description": "章の一意な ID (例: c1)" },
          "title": { "type": "string", "description": "H2。体言止め、20 文字以内が目安" },
          "evidence_type": { "type": "string", "enum": ["crawl_required", "crawl_optional", "generic_only_ok"] },
          "targetCharCount": { "type": "integer", "minimum": 0, "description": "章の目標文字数。節がある場合は節の合計" },
          "overview": { "type": "string", "description": "この章で執筆する内容の短い説明" },
          "cautions": { "type": "array", "items": { "type": "string" } },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "targetCharCount", "overview", "cautions"],
              "properties": {
                "id": { "type": "string", "description": "節の一意な ID (例: s1)" },
                "title": { "type": "string", "description": "H3。体言止め、25 文字以内が目安" },
                "targetCharCount": { "type": "integer", "minimum": 0, "description": "400 以上が目安" },
                "overview": { "type": "string" },
                "cautions": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "chapterId", "sectionId", "title", "url", "excerpt", "intendedUse"],
        "properties": {
          "id": { "type": "string", "description": "参照の一意な ID (例: r1)。同一記事の複数抜粋は別エントリにする" },
          "chapterId": { "type": "string" },
          "sectionId": { "type": ["string", "null"], "description": "章全体に割り当てる場合は null" },
          "title": { "type": "string", "description": "reportResources の title" },
          "url": { "type": "string", "description": "reportResources の url と完全一致" },
          "excerpt": { "type": "string", "description": "reportResources の content の連続した原文。要約・結合・省略記号は不可" },
          "intendedUse": { "type": "string", "description": "この抜粋で支える説明" }
        }
      }
    },
    "coverage_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adoptedSlots", "missingSlots", "crawlRequiredRatio"],
      "properties": {
        "adoptedSlots": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["定義・前提", "背景・課題", "全体像・仕組み", "種類・分類", "メリット・デメリット", "適用条件・ユースケース", "手順・進め方", "比較・選び方", "失敗例・注意点", "事例・データ"]
          }
        },
        "missingSlots": {
          "type": "array",
          "description": "必要なのに構成または具体情報が不足するスロット",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "reason"],
            "properties": {
              "slot": { "type": "string" },
              "reason": { "type": "string", "enum": ["no_source", "insufficient_source", "condition_mismatch"] }
            }
          }
        },
        "crawlRequiredRatio": { "type": "number", "minimum": 0, "maximum": 1, "description": "crawl_required の H2 数 ÷ 全 H2 数" }
      }
    }
  }
}
