# Server-side only. Never expose these to the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: fine-grained GitHub PAT (Contents: Read) for cloning private repositories.
GITHUB_TOKEN=

# Optional overrides
# OPENAI_AGENT_MODEL=gpt-5.6-sol
# ANTHROPIC_AGENT_MODEL=claude-opus-5
# ANTHROPIC_AGENT_ID=agent_...           # reuse an existing Managed Agent instead of creating one
# ANTHROPIC_ENVIRONMENT_ID=env_...       # reuse an existing environment
# ANTHROPIC_WORKSPACE=default            # used only to print Console trace links
# OPENAI_INPUT_PRICE_PER_MILLION=4       # USD, used for the OpenAI cost estimate
# OPENAI_CACHED_INPUT_PRICE_PER_MILLION=0.4
# OPENAI_OUTPUT_PRICE_PER_MILLION=20
# AGENT_LAB_DATA_DIR=.agent-lab
